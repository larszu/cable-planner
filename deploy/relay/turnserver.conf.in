# coturn fuer die Live-Zusammenarbeit (cable-planner #869).
# Vorlage: relay-deploy setzt @TURN_SECRET@ und @REALM@ ein und schreibt
# /opt/relay/turnserver.conf (nur fuer coturn lesbar). Nie mit Secret ins Repo.
listening-port=3478
tls-listening-port=5349
realm=@REALM@
server-name=@REALM@
fingerprint

# Kein offenes Relay: nur kurzlebige Zugangsdaten, die devices.zumpelars.de
# angemeldeten Konten ausstellt (TURN REST API, /api/turn-credentials).
use-auth-secret
static-auth-secret=@TURN_SECRET@
stale-nonce=600

cert=/certs/fullchain.pem
pkey=/certs/privkey.pem

min-port=49160
max-port=49200

# Weitergeleitet wird nur ins Internet, nie ins Netz des VPS selbst oder in
# private Bereiche — sonst waere TURN ein Tunnel zu lz-share-Diensten.
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=@PUBLIC_IP@

# Traffic kostet: Live-Zusammenarbeit tauscht CRDT-Updates (Kilobyte), keine
# Videostroeme. 500 kB/s je Sitzung, 5 MB/s fuer alle zusammen.
max-bps=500000
bps-capacity=5000000
user-quota=10
total-quota=100

no-cli
log-file=stdout
simple-log
